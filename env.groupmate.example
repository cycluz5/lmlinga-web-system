    # LMLinga - GROUPMATE TESTING configuration (placeholders only).
# Copy this file to ".env" in the project folder, then follow GROUPMATE_SETUP.md.
# Never commit .env. Never use real resident data or production credentials here.

APP_NAME=LMLinga
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# REQUIRED - leave empty here, then run: php artisan key:generate
APP_KEY=

# REQUIRED - generate YOUR OWN key and paste it after the = sign. It must be different from APP_KEY:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# The fictional SQL file needs no shared key. Keep yours for as long as your local database exists.
LMLINGA_AT_REST_KEY=
LMLINGA_AT_REST_KEY_ID=local1
LMLINGA_AT_REST_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# REQUIRED - your own local database. MariaDB 10.11 is recommended; avoid the MariaDB 10.4 in older XAMPP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lmlinga_groupmate_test
DB_USERNAME=lmlinga_testing
DB_PASSWORD=CHANGE_ME_YOUR_OWN_LOCAL_DB_PASSWORD
# Only if "mysql"/"mariadb" is not on your PATH (folder that contains the program):
# DB_CLIENT_BIN_PATH=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# E-mail: keep "log". Messages and OTP codes go to storage/logs/laravel.log and nothing is sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (Semaphore): leave EMPTY. SMS sending stays disabled.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Chatbot AI (Ollama): optional. Leave OLLAMA_API_KEY empty and use a local model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
# OLLAMA_CHAT_PROVIDER=local
# OLLAMA_CHAT_MODEL=
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Spot Mapping demo location (fake GPS). Keep false unless rehearsing the demo.
LMLINGA_DEMO_LOCATION_ENABLED=false

# Leave all of these empty when you import lmlinga_groupmate_test.sql; the accounts are already included.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=superadmin@example.invalid
SEED_STAFF_PASSWORD=
CLIENT_TESTING_STAFF_PASSWORD=
CLIENT_TESTING_RESIDENT_PASSWORD=
DEMO_STAFF_ADMIN_EMAIL=
DEMO_STAFF_ADMIN_PASSWORD=
DEMO_STAFF_WORKER_EMAIL=
DEMO_STAFF_WORKER_PASSWORD=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"
