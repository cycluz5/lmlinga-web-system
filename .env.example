APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# UI-phase demo staff login (session UiRole only — not production auth).
# Set local values in .env. Do not commit real passwords.
DEMO_STAFF_ADMIN_EMAIL=admin@example.test
DEMO_STAFF_ADMIN_PASSWORD=change-me-locally
DEMO_STAFF_ADMIN_NAME="Demo Admin"
DEMO_STAFF_ADMIN_ROLE=admin
DEMO_STAFF_ADMIN_IDENTITIES=admin@example.test
DEMO_STAFF_WORKER_EMAIL=worker@example.test
DEMO_STAFF_WORKER_PASSWORD=change-me-locally
DEMO_STAFF_WORKER_NAME="Demo Worker"
DEMO_STAFF_WORKER_ROLE=bhw
DEMO_STAFF_WORKER_IDENTITIES=worker@example.test

# AES-256-GCM at-rest field encryption. Dedicated key — never reuse APP_KEY.
# Format: base64:<standard Base64 of exactly 32 raw bytes>
LMLINGA_AT_REST_KEY=
LMLINGA_AT_REST_KEY_ID=k1
LMLINGA_AT_REST_PREVIOUS_KEYS=
# Emergency write-disable only. Omit or true in production. false stores new writes as plaintext;
# existing ciphertext still decrypts when valid keys exist. Missing keys never auto-downgrade writes.
# LMLINGA_AT_REST_ENABLED=true
