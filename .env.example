# LMLinga - LOCAL TESTING configuration template (placeholders only).
# Copy to .env and fill in YOUR OWN local values. Never commit .env. Never use real resident data.

APP_NAME=LMLinga
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# Generate with: php artisan key:generate
APP_KEY=

# AES-256-GCM at-rest encryption for health-record fields. REQUIRED. Must be DIFFERENT from APP_KEY.
# Generate your own local test key with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Keep it for as long as your local database exists; losing it makes encrypted test fields unreadable.
LMLINGA_AT_REST_KEY=
LMLINGA_AT_REST_KEY_ID=local1
LMLINGA_AT_REST_PREVIOUS_KEYS=
# LMLINGA_AT_REST_ENABLED=true

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 10.11 (recommended). Do NOT use the XAMPP-bundled MariaDB 10.4.32 (known crash defect).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lmlinga_testing
DB_USERNAME=lmlinga_testing
DB_PASSWORD=
# Folder containing mysql(.exe); needed by `php artisan migrate` to load database/schema/mysql-schema.sql
# DB_CLIENT_BIN_PATH=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mail: keep "log" for testing - messages (including OTP codes) are written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (Semaphore): leave EMPTY for testing - SMS sending stays disabled.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# SEMAPHORE_BASE_URL=

# Chatbot AI (Ollama). Optional for testing. Use a LOCAL model; leave OLLAMA_API_KEY empty.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
# OLLAMA_CHAT_PROVIDER=local
# OLLAMA_CHAT_MODEL=
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Spot Mapping demo location (fake GPS). Keep false unless rehearsing the demo.
LMLINGA_DEMO_LOCATION_ENABLED=false

# Seeder passwords: SET YOUR OWN before running migrations or seeders. There are no built-in defaults:
# without SUPER_ADMIN_PASSWORD the administrator account is simply not created.
SUPER_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SUPER_ADMIN_EMAIL=superadmin@example.invalid
# Only for php artisan client-testing:provision (development tool). Leave empty unless you need it.
CLIENT_TESTING_STAFF_PASSWORD=
CLIENT_TESTING_RESIDENT_PASSWORD=

# UI-phase demo staff login (legacy, unused in ERD mode). Leave empty.
DEMO_STAFF_ADMIN_EMAIL=
DEMO_STAFF_ADMIN_PASSWORD=
DEMO_STAFF_WORKER_EMAIL=
DEMO_STAFF_WORKER_PASSWORD=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"